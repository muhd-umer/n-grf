    TORCH_CHECK(B.size(0) == N && B.size(1) == 3 && B.size(2) == 3,
                "B must have shape Nx3x3");
    TORCH_CHECK(C.size(0) == N && C.size(1) == 3 && C.size(2) == 3,
                "C must have shape Nx3x3");

